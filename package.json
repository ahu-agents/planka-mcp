{
  "name": "@ahu-agents/planka-mcp",
  "version": "0.1.0",
  "description": "Streamable HTTP MCP server for Planka/Kanban automation",
  "type": "module",
  "bin": {
    "planka-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:stdio": "PLANKA_MCP_TRANSPORT=stdio node dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "smoke:live": "npm run build && node dist/src/smoke-live.js"
  },
  "keywords": [
    "mcp",
    "planka",
    "kanban",
    "model-context-protocol",
    "streamable-http"
  ],
  "author": "ahu-agents",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  }
}
