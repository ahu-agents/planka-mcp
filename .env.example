# Human/internal Planka URL, without trailing slash preferred
PLANKA_BASE_URL=https://planka.home.arpa

# Service account credentials. The server exchanges these for a short-lived JWT.
PLANKA_AGENT_EMAIL=agent@example.invalid
PLANKA_AGENT_PASSWORD=change-me

# Transport: streamable-http (default) or stdio
PLANKA_MCP_TRANSPORT=streamable-http
PLANKA_MCP_HOST=127.0.0.1
PLANKA_MCP_PORT=3333
PLANKA_MCP_PATH=/mcp

# Optional: set to 1 to expose the generic planka_request tool.
PLANKA_MCP_ENABLE_RAW=0
PLANKA_MCP_REQUEST_TIMEOUT_MS=30000
